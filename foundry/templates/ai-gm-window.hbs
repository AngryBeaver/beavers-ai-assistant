<div class="beavers-ai-gm-window">

  {{!-- Header: flush to the top of window-content, gradient + border-bottom --}}
  {{#if loreIndexExists}}
  <div class="beavers-ai-header">
    <select id="ai-chapter-select">
      {{#each availableChapters}}
        <option value="{{this}}" {{#if (eq this ../selectedChapter)}}selected{{/if}}>{{this}}</option>
      {{/each}}
    </select>
    <select id="ai-scene-select">
      <option value="">— any scene —</option>
      {{#each availableScenes}}
        <option value="{{this}}" {{#if (eq this ../selectedScene)}}selected{{/if}}>{{this}}</option>
      {{/each}}
    </select>
  </div>
  {{else}}
  <div class="beavers-ai-header beavers-ai-header--empty">
    <i class="fas fa-circle-info"></i>
    <span>Adventure not configured yet.</span>
    <button type="button" data-action="openAdventureSetup">
      <i class="fas fa-wand-magic-sparkles"></i> Adventure Setup
    </button>
  </div>
  {{/if}}

  {{!-- Body: owns the 16px padding --}}
  <div class="beavers-ai-body">

    {{!-- Context inclusion checkboxes --}}
    <div class="beavers-ai-ctx-flags">
      <label><input type="checkbox" name="ctx-scene" {{#if contextFlags.scene}}checked{{/if}}> Scene</label>
      <label><input type="checkbox" name="ctx-locationScene" {{#if contextFlags.locationScene}}checked{{/if}}> Location</label>
      <label><input type="checkbox" name="ctx-overview" {{#if contextFlags.overview}}checked{{/if}}> Overview</label>
      <label><input type="checkbox" name="ctx-actor" {{#if contextFlags.actor}}checked{{/if}}> Actor</label>
      <label><input type="checkbox" name="ctx-session" {{#if contextFlags.session}}checked{{/if}}> Session</label>
    </div>

    {{!-- Bordered context box, ~400px, shows phase content --}}
    <div class="beavers-ai-context">

      {{#if (eq phase "asking")}}
      <div class="beavers-ai-status">
        <i class="fas fa-spinner fa-spin"></i>
      </div>
      <div class="beavers-ai-response"></div>
      {{/if}}

      {{#if (eq phase "asked")}}
      <div class="beavers-ai-response">{{response}}</div>
      {{/if}}

    </div>{{!-- .beavers-ai-context --}}

    {{!-- Question textarea --}}
    <textarea id="ai-question-input" class="beavers-ai-question"
      placeholder="Ask a question about the selected scene…">{{questionText}}</textarea>

    {{!-- Button row --}}
    <div class="beavers-ai-controls">
      <button type="button" data-action="send" {{#unless selectedScene}}disabled{{/unless}}>
        <i class="fas fa-paper-plane"></i> Send
      </button>
      {{#if (eq phase "asking")}}
      <button type="button" data-action="stop">
        <i class="fas fa-stop"></i> Stop
      </button>
      {{/if}}
    </div>

  </div>{{!-- .beavers-ai-body --}}

</div>